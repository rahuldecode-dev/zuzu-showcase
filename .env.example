# Email capture for the "Get the code" form (and ManyChat, via /api/subscribe).
# Pick ONE provider and fill its keys. Never commit your real .env.local.
EMAIL_PROVIDER=kit            # kit | beehiiv | webhook

# Kit (kit.com): Settings → Developer → API key (v4). Form ID is in the form's URL.
KIT_API_KEY=
KIT_FORM_ID=

# beehiiv: Settings → API. Publication ID starts with pub_
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Generic: POSTs { email, source, subscribedAt } as JSON (Zapier, Make, your backend…)
EMAIL_WEBHOOK_URL=
